# AIONIX GEAR — variáveis de ambiente (copie para .env e preencha; nunca commite segredos)

# PostgreSQL. Em produção: URL pública (proxy TCP) do Postgres do Railway.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/BANCO"
# Máximo de conexões por instância (serverless: mantenha baixo)
DATABASE_POOL_MAX="5"

# Apenas desenvolvimento/testes locais (node scripts/local-db.mjs)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/aionix_gear_test"

# URL pública do app (usada em links de convite, QR codes e compartilhamento)
APP_URL="https://seu-dominio.vercel.app"

# Nome exibido do produto (marca configurável)
NEXT_PUBLIC_BRAND_NAME="AIONIX GEAR"

# Armazenamento de fotos/documentos. Se vazio, os arquivos ficam no próprio Postgres.
# Vercel Blob (store privado): token gerado ao conectar o store ao projeto.
BLOB_READ_WRITE_TOKEN=""

